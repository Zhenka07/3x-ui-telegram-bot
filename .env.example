# =============================================
# 3x-ui Admin Bot — переменные окружения
# =============================================

# === Telegram ===
# Токен ОТДЕЛЬНОГО бота для админки (получить у @BotFather).
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# Telegram ID администраторов, через запятую. Только эти пользователи
# могут взаимодействовать с ботом. Остальные — тихий игнор.
ADMIN_IDS=123456789,987654321

# === 3x-ui Panel ===
# Базовый URL панели 3x-ui (включая порт, без завершающего /).
XUI_BASE_URL=https://panel.example.com:2053

# Логин и пароль администратора панели.
XUI_USERNAME=admin
XUI_PASSWORD=secretpassword

# Отключить проверку TLS-сертификата (для self-signed).
# Допустимые значения: true, false (по умолчанию false).
XUI_INSECURE_SKIP_VERIFY=true

# === Server ===
# IP-адрес или hostname сервера, используется для сборки vless-ссылок.
SERVER_HOST=1.2.3.4

# === SSH Tunnel (Опционально) ===
# Позволяет безопасно подключаться к закрытой панели без открытия ее порта наружу.
SSH_ENABLED=false
SSH_HOST=1.2.3.4
SSH_PORT=22
SSH_USER=root
# Укажите путь к приватному SSH-ключу (например, /root/.ssh/id_rsa) ИЛИ пароль:
SSH_KEY_PATH=
SSH_PASSWORD=

# === Опциональные ===
# Уровень логирования: debug, info, warn, error (по умолчанию info).
LOG_LEVEL=info

# Таймаут HTTP-запросов к панели (по умолчанию 20s).
XUI_TIMEOUT=20s

# Таймаут long polling Telegram (по умолчанию 10s).
TELEGRAM_POLLER_TIMEOUT=10s

